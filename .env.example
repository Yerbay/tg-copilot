# --- Telegram API (одно приложение на всех пользователей) ---
# Получить на https://my.telegram.org → API development tools (войти этим же аккаунтом)
TG_API_ID=
TG_API_HASH=

# --- Бот-консультант ---
# Создайте бота у @BotFather (/newbot) и вставьте токен
BOT_TOKEN=
# Telegram ID администратора: он пускает других пользователей (кнопкой в боте) и видит /users.
# Узнать свой ID: напишите @userinfobot. (Старое имя этой настройки — OWNER_ID, тоже работает.)
ADMIN_ID=
# Сколько человек может пользоваться ботом (вместе с администратором)
MAX_USERS=10
# Запросов к ИИ в день на пользователя (администратору без лимита)
USER_DAILY_LIMIT=150

# --- WhatsApp ---
# Мост в папке wa/ (нужен Node.js 20+ и `npm install` в wa/). QR для привязки бот пришлёт в Telegram.
WA_ENABLED=true

# --- LLM ---
# Провайдер: deepseek | gemini | openai | claude | ollama
# Ключ DeepSeek: https://platform.deepseek.com → API keys
LLM_PROVIDER=deepseek
# Быстрая модель — варианты ответа, «ещё/короче/теплее», разбор черновика
LLM_MODEL=deepseek-flash
# Умная модель — разбор переписки, консультации, вечерний отчёт и карточки (пусто = та же, что LLM_MODEL)
LLM_MODEL_SMART=deepseek-v4-pro
LLM_API_KEY=
# Необязательно: свой адрес API (прокси, локальный сервер)
LLM_BASE_URL=

# Примеры для переключения:
#   LLM_PROVIDER=deepseek  LLM_MODEL=deepseek-v4-pro   (умнее, медленнее и дороже)
#   LLM_PROVIDER=gemini    LLM_MODEL=gemini-2.5-flash
#   LLM_PROVIDER=openai    LLM_MODEL=gpt-4o-mini
#   LLM_PROVIDER=claude    LLM_MODEL=claude-sonnet-5
#   LLM_PROVIDER=ollama    LLM_MODEL=qwen2.5:14b   (ключ не нужен)

# --- Распознавание речи: голосовые из переписок и голосовые боту ---
# Ключ Gemini: https://aistudio.google.com/apikey  (пусто — голосовые не распознаются)
# Модели через запятую: если первая недоступна или перегружена, берётся следующая
STT_API_KEY=
STT_MODEL=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3-flash-preview

# --- Поведение ---
TIMEZONE=Asia/Almaty
DAILY_HOUR=21
DEBOUNCE_SECONDS=15
DEBOUNCE_MAX_SECONDS=120
HISTORY_LIMIT=30
NUM_VARIANTS=3
WAITING_HOURS=20
SILENCE_DAYS=3
